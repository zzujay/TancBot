# =============================================================================
# 国产LLM模型配置示例
# =============================================================================
# 复制此文件为 .env 并根据需要修改配置

# =============================================================================
# 通义千问 (Qwen) 配置 - 推荐⭐⭐⭐⭐⭐
# =============================================================================
# 阿里云通义千问，中文理解最佳，API稳定性好
LLM_PROVIDER=qwen
LLM_MODEL=qwen-turbo
QWEN_API_KEY=sk-your-qwen-api-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QWEN_API_VERSION=2023-12-01

# =============================================================================
# Kimi 配置 - 推荐⭐⭐⭐⭐
# =============================================================================
# 月之暗面Kimi，长文本处理强，对话体验好
# LLM_PROVIDER=kimi
# LLM_MODEL=kimi-chat
# KIMI_API_KEY=your-kimi-api-key-here
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# =============================================================================
# 文心一言 配置 - 推荐⭐⭐⭐
# =============================================================================
# 百度文心一言，知识图谱丰富，百度生态集成好
# LLM_PROVIDER=wenxin
# LLM_MODEL=ernie-bot
# WENXIN_API_KEY=your-wenxin-api-key
# WENXIN_SECRET_KEY=your-wenxin-secret-key
# WENXIN_BASE_URL=https://aip.baidubce.com/rpc/2.0/ai_custom/v1/wenxinworkshop/chat

# =============================================================================
# 智谱GLM 配置 - 推荐⭐⭐⭐⭐
# =============================================================================
# 智谱AI GLM模型，学术能力强，中文理解好
# LLM_PROVIDER=zhipu
# LLM_MODEL=glm-4
# ZHIPU_API_KEY=your-zhipu-api-key
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# =============================================================================
# 通用LLM配置参数
# =============================================================================

# 最大令牌数 (根据模型调整)
# 千问: 1-128000, Kimi: 1-128000, 文心一言: 1-4096, 智谱: 1-128000
LLM_MAX_TOKENS=2048

# 温度参数 (0-2, 越高越随机)
LLM_TEMPERATURE=0.7

# 请求超时时间 (毫秒)
LLM_TIMEOUT=30000

# =============================================================================
# 分析配置
# =============================================================================

# 最大工作线程数
ANALYSIS_MAX_WORKERS=3

# 批量处理大小 (国产模型建议小批量)
ANALYSIS_BATCH_SIZE=5

# 分析重试次数
ANALYSIS_RETRY_ATTEMPTS=3

# 重试延迟 (毫秒)
ANALYSIS_RETRY_DELAY=1000

# 最大输入长度 (字符)
MAX_INPUT_LENGTH=10000

# =============================================================================
# 性能配置 (针对国产模型优化)
# =============================================================================

# 最大并发请求数 (避免触发限流)
MAX_CONCURRENT_REQUESTS=3

# 请求超时时间 (毫秒)
REQUEST_TIMEOUT=30000

# 缓存配置
CACHE_ENABLED=true
CACHE_TTL=3600000

# =============================================================================
# 安全配置
# =============================================================================

# API速率限制 (每分钟请求数)
RATE_LIMIT_PER_MINUTE=30

# 敏感词过滤
ENABLE_SENSITIVE_WORD_FILTER=true

# =============================================================================
# 监控配置
# =============================================================================

# 是否启用监控
ENABLE_METRICS=true

# 监控指标端口
METRICS_PORT=9090

# 日志配置
LOG_LEVEL=info
LOG_LLM_REQUESTS=false