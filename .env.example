# =============================================================================
# 公共舆情监控系统 - 配置文件示例
# =============================================================================
# 复制此文件为 .env 并根据需要修改配置
# 重要提示：永远不要将真实的 .env 文件提交到版本控制

# =============================================================================
# 基础系统配置
# =============================================================================

# 系统环境 (development, testing, production)
NODE_ENV=development

# 服务器配置
PORT=3000
HOST=localhost

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# =============================================================================
# LLM (大语言模型) 配置
# =============================================================================

# LLM提供商 (openai, claude, local)
LLM_PROVIDER=openai

# 使用的具体模型
LLM_MODEL=gpt-3.5-turbo

# 最大令牌数 (1-128000, 根据模型调整)
LLM_MAX_TOKENS=2048

# 温度参数 (0-2, 越高越随机)
LLM_TEMPERATURE=0.7

# 请求超时时间 (毫秒)
LLM_TIMEOUT=30000

# =============================================================================
# OpenAI 配置
# =============================================================================

# OpenAI API密钥 (必需，如果 LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI API基础URL (通常不需要修改)
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI组织ID (可选)
OPENAI_ORGANIZATION=

# =============================================================================
# Claude (Anthropic) 配置
# =============================================================================

# Claude API密钥 (必需，如果 LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key-here

# Claude API基础URL (通常不需要修改)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Claude API版本
ANTHROPIC_VERSION=2023-06-01

# =============================================================================
# 本地LLM配置
# =============================================================================

# 本地LLM服务URL (如果 LLM_PROVIDER=local)
LOCAL_LLM_URL=http://localhost:11434/api/generate

# 本地LLM请求超时时间 (毫秒)
LOCAL_LLM_TIMEOUT=30000

# =============================================================================
# 数据库配置
# =============================================================================

# 数据库类型 (sqlite, mysql, postgresql)
DB_TYPE=sqlite

# SQLite数据库文件路径
DB_SQLITE_PATH=data/opinion.db

# MySQL配置 (如果使用MySQL)
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_USER=root
DB_MYSQL_PASSWORD=your-mysql-password
DB_MYSQL_DATABASE=opinion_monitor

# PostgreSQL配置 (如果使用PostgreSQL)
DB_PG_HOST=localhost
DB_PG_PORT=5432
DB_PG_USER=postgres
DB_PG_PASSWORD=your-postgres-password
DB_PG_DATABASE=opinion_monitor

# =============================================================================
# Redis缓存配置
# =============================================================================

# 是否启用缓存
CACHE_ENABLED=true

# Redis连接配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 缓存过期时间 (毫秒)
CACHE_TTL=3600000

# 分析结果缓存时间 (毫秒)
ANALYSIS_CACHE_TTL=1800000

# =============================================================================
# 数据采集配置
# =============================================================================

# 数据采集间隔 (毫秒)
COLLECTION_INTERVAL=60000

# 最大采集数量 (每次)
MAX_COLLECTIONS_PER_RUN=100

# 数据采集超时时间 (毫秒)
COLLECTION_TIMEOUT=30000

# 用户代理字符串
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# =============================================================================
# 微博数据采集配置
# =============================================================================

# 微博搜索URL模板
WEIBO_SEARCH_URL=https://s.weibo.com/weibo?q={keyword}&page={page}

# 微博采集最大页数
WEIBO_MAX_PAGES=5

# 微博采集延迟 (毫秒，避免被封)
WEIBO_DELAY=2000

# =============================================================================
# 知乎数据采集配置
# =============================================================================

# 知乎搜索URL模板
ZHIHU_SEARCH_URL=https://www.zhihu.com/search?type=content&q={keyword}

# 知乎采集最大结果数
ZHIHU_MAX_RESULTS=50

# 知乎采集延迟 (毫秒)
ZHIHU_DELAY=3000

# =============================================================================
# 新闻数据采集配置
# =============================================================================

# 新闻源配置 (逗号分隔)
NEWS_SOURCES=baidu,sina,sohu

# 百度新闻搜索URL
BAIDU_NEWS_URL=https://news.baidu.com/ns?word={keyword}

# 新浪新闻搜索URL
SINA_NEWS_URL=https://search.sina.com.cn/?q={keyword}

# 搜狐新闻搜索URL
SOHU_NEWS_URL=https://news.sohu.com/_scroll_newslist/{keyword}

# =============================================================================
# AI分析配置
# =============================================================================

# 最大工作线程数
ANALYSIS_MAX_WORKERS=3

# 批量处理大小
ANALYSIS_BATCH_SIZE=10

# 分析重试次数
ANALYSIS_RETRY_ATTEMPTS=3

# 重试延迟 (毫秒)
ANALYSIS_RETRY_DELAY=1000

# 情感分析置信度阈值
SENTIMENT_CONFIDENCE_THRESHOLD=0.7

# 风险等级阈值 (1-10)
RISK_LEVEL_THRESHOLD=7

# 影响力分数阈值 (1-10)
INFLUENCE_SCORE_THRESHOLD=6

# =============================================================================
# 多智能体系统配置
# =============================================================================

# 情感分析智能体
SENTIMENT_AGENT_ENABLED=true
SENTIMENT_AGENT_MODEL=gpt-3.5-turbo

# 主题建模智能体
TOPIC_AGENT_ENABLED=true
TOPIC_AGENT_MODEL=gpt-3.5-turbo

# 风险识别智能体
RISK_AGENT_ENABLED=true
RISK_AGENT_MODEL=gpt-3.5-turbo

# 影响力预测智能体
INFLUENCE_AGENT_ENABLED=true
INFLUENCE_AGENT_MODEL=gpt-3.5-turbo

# 多轮验证轮数
MULTI_ROUND_VALIDATION_ROUNDS=3

# 共识阈值 (0-1)
CONSENSUS_THRESHOLD=0.8

# =============================================================================
# 可视化配置
# =============================================================================

# 可视化数据保留时间 (毫秒)
VISUALIZATION_DATA_RETENTION=86400000

# 时间线更新间隔 (毫秒)
TIMELINE_UPDATE_INTERVAL=30000

# 图表数据点最大数量
MAX_CHART_DATA_POINTS=1000

# =============================================================================
# 性能配置
# =============================================================================

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=5

# 请求超时时间 (毫秒)
REQUEST_TIMEOUT=30000

# 内存使用限制 (MB)
MEMORY_LIMIT=512

# CPU使用限制 (百分比)
CPU_LIMIT=80

# =============================================================================
# 安全配置
# =============================================================================

# 最大输入长度 (字符)
MAX_INPUT_LENGTH=10000

# API速率限制 (每分钟请求数)
RATE_LIMIT_PER_MINUTE=60

# 敏感词过滤
ENABLE_SENSITIVE_WORD_FILTER=true
SENSITIVE_WORD_LIST=敏感词1,敏感词2,敏感词3

# IP白名单 (逗号分隔，留空表示不限制)
IP_WHITELIST=

# IP黑名单 (逗号分隔)
IP_BLACKLIST=

# =============================================================================
# 监控和告警配置
# =============================================================================

# 是否启用监控
ENABLE_METRICS=true

# 监控指标端口
METRICS_PORT=9090

# 告警配置
ENABLE_ALERTS=true
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USER=your-email@gmail.com
ALERT_EMAIL_PASSWORD=your-email-password
ALERT_EMAIL_TO=admin@yourcompany.com

# 系统健康检查间隔 (毫秒)
HEALTH_CHECK_INTERVAL=60000

# 磁盘空间告警阈值 (百分比)
DISK_SPACE_THRESHOLD=90

# 内存使用率告警阈值 (百分比)
MEMORY_THRESHOLD=85

# =============================================================================
# 日志和调试配置
# =============================================================================

# 是否记录LLM请求日志
LOG_LLM_REQUESTS=false

# LLM请求日志文件
LLM_REQUEST_LOG_FILE=logs/llm-requests.log

# 调试模式
DEBUG_MODE=false

# 详细日志
VERBOSE_LOGGING=false

# 性能分析
ENABLE_PROFILING=false

# =============================================================================
# 备份配置
# =============================================================================

# 是否启用自动备份
ENABLE_AUTO_BACKUP=true

# 备份间隔 (小时)
BACKUP_INTERVAL=24

# 备份保留天数
BACKUP_RETENTION_DAYS=30

# 备份存储路径
BACKUP_STORAGE_PATH=backups/

# =============================================================================
# 第三方集成配置
# =============================================================================

# 钉钉机器人Webhook
DINGTALK_WEBHOOK_URL=

# 企业微信机器人Webhook
WECHAT_WEBHOOK_URL=

# Slack Webhook
SLACK_WEBHOOK_URL=

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# 高级配置
# =============================================================================

# 机器学习模型路径
ML_MODELS_PATH=models/

# 自定义词典路径
CUSTOM_DICTIONARY_PATH=data/dictionary.txt

# 停用词列表路径
STOP_WORDS_PATH=data/stopwords.txt

# 同义词词典路径
SYNONYM_DICT_PATH=data/synonyms.txt

# =============================================================================
# 测试配置
# =============================================================================

# 测试模式
TEST_MODE=false

# 模拟数据模式
MOCK_DATA_MODE=false

# 单元测试配置
UNIT_TEST_TIMEOUT=10000

# 集成测试配置
INTEGRATION_TEST_TIMEOUT=30000

# =============================================================================
# 部署配置
# =============================================================================

# Docker部署配置
DOCKER_IMAGE_NAME=opinion-monitor
DOCKER_CONTAINER_NAME=opinion-monitor-app
DOCKER_PORT_MAPPING=3000:3000

# Kubernetes配置
K8S_NAMESPACE=opinion-monitor
K8S_REPLICAS=3
K8S_SERVICE_NAME=opinion-monitor-service

# CI/CD配置
CI_CD_PIPELINE=gitlab
CI_CD_BRANCH=main
CI_CD_ENVIRONMENT=production